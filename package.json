{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"try{require('node:fs').unlinkSync('package-lock.json')}catch(e){}\" && node -e \"try{require('node:fs').unlinkSync('yarn.lock')}catch(e){}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/frero-boufadil-car run dev"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
